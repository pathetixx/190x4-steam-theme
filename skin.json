{
  "name": "190x4",
  "author": "190x4",
  "description": "Cyberpunk command-center theme - red neon over graphite. Deep Steam reskin.",
  "version": "0.6.0",

  "github": { "owner": "pathetixx", "repo_name": "190x4-steam-theme" },
  "tags": ["Dark", "Cyberpunk", "Red", "Customizable"],

  "UseDefaultPatches": true,
  "Steam-WebKit": "webkit.css",
  "RootColors": "colors/root.css",

  "Patches": [
    { "MatchRegexString": ".*",                "TargetCss": "colors/accents-config.css" },
    { "MatchRegexString": "^Steam$",           "TargetCss": "client/elements.css" },
    { "MatchRegexString": "Menu$",             "TargetCss": "client/elements.css" },
    { "MatchRegexString": "SuperNav$",         "TargetCss": "client/elements.css" },
    { "MatchRegexString": ".ModalDialogPopup", "TargetCss": "client/elements.css" }
  ]
}
