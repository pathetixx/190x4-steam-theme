{
  "name": "190x4",
  "author": "190x4",
  "description": "Cyberpunk command-center theme - red neon over graphite. Deep Steam reskin.",
  "version": "1.1.0",

  "github": { "owner": "pathetixx", "repo_name": "190x4-steam-theme" },
  "tags": ["Dark", "Cyberpunk", "Red", "Customizable"],

  "UseDefaultPatches": false,
  "RootColors": "colors/root.css",

  "Patches": [
    { "MatchRegexString": ".*", "TargetCss": "client/theme.css" },
    { "MatchRegexString": ".*", "TargetCss": "webkit.css" },
    { "MatchRegexString": ".friendsui-container", "TargetCss": "client/friends.css" },
    { "MatchRegexString": "Menu$", "TargetCss": "client/menu.css" },
    { "MatchRegexString": ".ModalDialogPopup", "TargetCss": "client/menu.css" },
    { "MatchRegexString": "^notificationtoasts_", "TargetCss": "client/menu.css" }
  ]
}
